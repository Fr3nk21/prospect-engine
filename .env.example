# Supabase (public keys safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server-side only, never commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Scraper microservice (Railway)
SCRAPER_SERVICE_URL=https://your-app.up.railway.app
SCRAPER_API_TOKEN=your-shared-secret

# Claude API — server-side only
ANTHROPIC_API_KEY=sk-ant-...

# Vercel Cron — shared secret Vercel sends as `Authorization: Bearer` on
# scheduled invocations (Vercel adds this automatically when this env var
# is set on the project); the cron route checks it, same pattern as
# SCRAPER_API_TOKEN
CRON_SECRET=your-cron-secret

# Gmail OAuth (Module 4 — leave blank for now)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
